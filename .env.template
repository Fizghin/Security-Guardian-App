DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- DATABASE ---
# SQLite is default, but you can override here
# DATABASE_URL=sqlite:///./sql_app.db

# --- SYSTEM SETTINGS ---
# THREAT_LEVEL_THRESHOLD=3
