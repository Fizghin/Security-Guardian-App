# Guardian configuration. Copy to backend/.env and edit.
# Settings changed later in the dashboard are saved to backend/storage/settings.json
# and take priority over the values here.

# ---- Server -------------------------------------------------------------------
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your network (no login!).
HOST=127.0.0.1
PORT=8000

# HTTPS port phones use as cameras (Settings → Cameras → Add camera → Phone).
# It only serves the phone camera page, never the dashboard. 0 turns phone cameras off.
PHONE_PORT=8443

# Password for the dashboard. Set one whenever other devices can reach it (HOST=0.0.0.0,
# a reverse proxy or a tunnel). Browsers get a sign-in page; scripts can use HTTP Basic auth.
DASHBOARD_PASSWORD=

# The https address of this server behind a reverse proxy or tunnel, e.g. https://guardian.example.com.
# Phone pairing links then use it, so phones can connect from anywhere, not just your Wi-Fi.
PUBLIC_URL=

# ---- First camera ---------------------------------------------------------------
# Used until cameras are managed in the dashboard (Settings → Cameras).
# auto | 0, 1, 2 (webcam index) | rtsp://... or http://... (IP cam / DroidCam) | path to a video file
# | phone (a phone or any browser with a camera, paired in Settings → Cameras) | none
VIDEO_SOURCE=auto

# ---- Local language model ------------------------------------------------------
# ollama  -> Ollama (https://ollama.com), e.g. `ollama pull llama3.2:3b`
# openai  -> any OpenAI-compatible server: LM Studio (http://localhost:1234/v1),
#            llama.cpp server (http://localhost:8080/v1), vLLM, ...
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to use the first model installed in Ollama.
OLLAMA_MODEL=

# Only used when AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=
OPENAI_API_KEY=

# ---- Alerts (optional) -----------------------------------------------------------
# Easier to set in the dashboard (Settings → Notifications), which overrides these.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy topic address, e.g. https://ntfy.sh/a-long-secret-topic (NTFY_TOKEN only for protected topics)
NTFY_URL=
NTFY_TOKEN=
# Receives a JSON POST for every alert
WEBHOOK_URL=

# E-mail. For Gmail use an App Password (Google account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
